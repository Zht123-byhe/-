# ---------------------------- 数据库管理模块 ----------------------------
class DatabaseManager:
    """数据库统一管理类"""
    def __init__(self, db_name="campus_system.db"):
        self.db_name = db_name
        self.conn = None
        self.cursor = None
        self._connect()
        self._init_tables()

    def _connect(self):
        try:
            self.conn = sqlite3.connect(self.db_name)
            self.cursor = self.conn.cursor()
            self.conn.execute("PRAGMA foreign_keys = ON")
        except sqlite3.Error as e:
            messagebox.showerror("数据库错误", f"连接失败：{e}")

    def _init_tables(self):
        """初始化所有数据表"""
        # 用户表（登录）
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS users (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT UNIQUE NOT NULL,
                password TEXT NOT NULL,
                role TEXT DEFAULT 'user',
                real_name TEXT,
                created_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        # 班级表
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS classes (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                class_id TEXT UNIQUE NOT NULL,
                class_name TEXT NOT NULL,
                grade INTEGER,
                department TEXT
            )
        """)
        # 学生表
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS students (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                student_id TEXT UNIQUE NOT NULL,
                name TEXT NOT NULL,
                age INTEGER,
                gender TEXT,
                class_id TEXT,
                phone TEXT,
                address TEXT,
                enrollment_date TEXT,
                FOREIGN KEY (class_id) REFERENCES classes(class_id) ON DELETE SET NULL
            )
        """)
        # 课程表
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS courses (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                course_id TEXT UNIQUE NOT NULL,
                course_name TEXT NOT NULL,
                credit REAL,
                teacher TEXT,
                semester TEXT
            )
        """)
        # 成绩表
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS scores (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                student_id TEXT NOT NULL,
                course_id TEXT NOT NULL,
                score REAL,
                exam_date TEXT,
                FOREIGN KEY (student_id) REFERENCES students(student_id) ON DELETE CASCADE,
                FOREIGN KEY (course_id) REFERENCES courses(course_id) ON DELETE CASCADE,
                UNIQUE(student_id, course_id)
            )
        """)
        # 日志表
        self.cursor.execute("""
            CREATE TABLE IF NOT EXISTS logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                username TEXT,
                action TEXT,
                detail TEXT,
                log_time TIMESTAMP DEFAULT CURRENT_TIMESTAMP
            )
        """)
        self.conn.commit()
        # 创建默认管理员（密码 123456）
        admin_pwd = hashlib.sha256("123456".encode()).hexdigest()
        self.cursor.execute("INSERT OR IGNORE INTO users (username, password, role, real_name) VALUES (?, ?, ?, ?)",
                           ("admin", admin_pwd, "admin", "系统管理员"))
        self.conn.commit()

    def execute(self, sql, params=()):
        try:
            self.cursor.execute(sql, params)
            self.conn.commit()
            return True
        except Exception as e:
            messagebox.showerror("执行错误", str(e))
            return False

    def query(self, sql, params=()):
        try:
            self.cursor.execute(sql, params)
            return self.cursor.fetchall()
        except Exception as e:
            messagebox.showerror("查询错误", str(e))
            return []

    def close(self):
        if self.conn:
            self.conn.close()

# ---------------------------- 日志装饰器 ----------------------------
def log_action(action):
    def decorator(func):
        @wraps(func)
        def wrapper(self, *args, **kwargs):
            result = func(self, *args, **kwargs)
            if hasattr(self, 'db') and hasattr(self, 'current_user'):
                detail = f"{action}: {args}"
                self.db.execute("INSERT INTO logs (username, action, detail) VALUES (?, ?, ?)",
                               (self.current_user[0], action, detail))
            return result
        return wrapper
    return decorator

# ---------------------------- 登录窗口 ----------------------------
class LoginWindow:
    def __init__(self):
        self.root = tk.Tk()
        self.root.title("校园学生信息管理系统 - 登录")
        self.root.geometry("400x300")
        self.root.resizable(False, False)
        self.db = DatabaseManager()
        self.current_user = None
        self.create_widgets()
        self.root.mainloop()

    def create_widgets(self):
        frame = tk.Frame(self.root, padx=30, pady=30)
        frame.pack(expand=True, fill="both")
        tk.Label(frame, text="校园学生信息管理系统", font=("微软雅黑", 18, "bold")).grid(row=0, column=0, columnspan=2, pady=20)
        tk.Label(frame, text="用户名：", font=("微软雅黑", 12)).grid(row=1, column=0, sticky="e", pady=8)
        self.entry_user = tk.Entry(frame, font=("微软雅黑", 12), width=18)
        self.entry_user.grid(row=1, column=1, pady=8)
        tk.Label(frame, text="密码：", font=("微软雅黑", 12)).grid(row=2, column=0, sticky="e", pady=8)
        self.entry_pwd = tk.Entry(frame, font=("微软雅黑", 12), width=18, show="*")
        self.entry_pwd.grid(row=2, column=1, pady=8)
        btn_frame = tk.Frame(frame)
        btn_frame.grid(row=3, column=0, columnspan=2, pady=20)
        tk.Button(btn_frame, text="登录", width=10, command=self.login).pack(side="left", padx=10)
        tk.Button(btn_frame, text="退出", width=10, command=self.root.quit).pack(side="left", padx=10)
        self.entry_user.focus()
        self.root.bind('<Return>', lambda e: self.login())

    def login(self):
        username = self.entry_user.get().strip()
        password = self.entry_pwd.get().strip()
        if not username or not password:
            messagebox.showwarning("警告", "用户名和密码不能为空")
            return
        pwd_hash = hashlib.sha256(password.encode()).hexdigest()
        res = self.db.query("SELECT username, role, real_name FROM users WHERE username=? AND password=?", (username, pwd_hash))
        if res:
            self.current_user = res[0]
            self.db.execute("INSERT INTO logs (username, action, detail) VALUES (?, ?, ?)",
                           (username, "登录系统", "用户登录成功"))
            self.root.destroy()
            MainApp(self.current_user, self.db)
        else:
            messagebox.showerror("错误", "用户名或密码错误")

