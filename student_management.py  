        for row in rows:
            tree.insert("", "end", values=row)
        # 添加用户
        frame = tk.Frame(win)
        frame.pack(pady=10)
        tk.Label(frame, text="用户名:").pack(side="left")
        user_entry = tk.Entry(frame, width=12)
        user_entry.pack(side="left", padx=5)
        tk.Label(frame, text="密码:").pack(side="left")
        pwd_entry = tk.Entry(frame, width=12, show="*")
        pwd_entry.pack(side="left", padx=5)
        tk.Label(frame, text="角色:").pack(side="left")
        role_combo = ttk.Combobox(frame, values=["admin", "user"], width=8)
        role_combo.pack(side="left", padx=5)
        role_combo.set("user")
        tk.Button(frame, text="添加", command=lambda: self.add_user(user_entry.get(), pwd_entry.get(), role_combo.get(), tree)).pack(side="left", padx=5)

    def add_user(self, username, password, role, tree):
        if not username or not password:
            messagebox.showwarning("警告", "用户名和密码不能为空")
            return
        pwd_hash = hashlib.sha256(password.encode()).hexdigest()
        try:
            self.db.execute("INSERT INTO users (username, password, role) VALUES (?,?,?)", (username, pwd_hash, role))
            messagebox.showinfo("成功", "用户添加成功")
            tree.insert("", "end", values=(username, role, ""))
        except sqlite3.IntegrityError:
            messagebox.showerror("错误", "用户名已存在")

    def change_password(self):
        win = tk.Toplevel(self.root)
        win.title("修改密码")
        win.geometry("300x200")
        tk.Label(win, text="原密码:").pack(pady=5)
        old_entry = tk.Entry(win, show="*")
        old_entry.pack()
        tk.Label(win, text="新密码:").pack(pady=5)
        new_entry = tk.Entry(win, show="*")
        new_entry.pack()
        tk.Label(win, text="确认新密码:").pack(pady=5)
        confirm_entry = tk.Entry(win, show="*")
        confirm_entry.pack()
        def do_change():
            old = old_entry.get()
            new = new_entry.get()
            confirm = confirm_entry.get()
            if not old or not new:
                messagebox.showwarning("警告", "请输入原密码和新密码")
                return
            if new != confirm:
                messagebox.showwarning("警告", "两次输入的新密码不一致")
                return
            old_hash = hashlib.sha256(old.encode()).hexdigest()
            res = self.db.query("SELECT password FROM users WHERE username=?", (self.user[0],))
            if res and res[0][0] == old_hash:
                new_hash = hashlib.sha256(new.encode()).hexdigest()
                self.db.execute("UPDATE users SET password=? WHERE username=?", (new_hash, self.user[0]))
                messagebox.showinfo("成功", "密码修改成功，请重新登录")
                win.destroy()
                self.root.quit()
            else:
                messagebox.showerror("错误", "原密码错误")
        tk.Button(win, text="确定修改", command=do_change).pack(pady=10)

    def about(self):
        messagebox.showinfo("关于", "校园学生信息管理系统\n版本 2.0\n\n开发语言：Python 3 + Tkinter + SQLite\n功能：学生、课程、成绩、班级管理，数据导入导出\n\n© 2026 校园系统开发组")

    def on_close(self):
        self.db.close()
        self.root.destroy()

