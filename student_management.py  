        self.stat_text.delete(1.0, tk.END)
        self.stat_text.insert(tk.END, "成绩分布：\n")
        self.stat_text.insert(tk.END, f"60分以下: {low[0][0]}人\n")
        self.stat_text.insert(tk.END, f"60-80分: {mid[0][0]}人\n")
        self.stat_text.insert(tk.END, f"80分以上: {high[0][0]}人\n")

    # ---------------------------- 导入导出 ----------------------------
    def import_students(self):
        filepath = filedialog.askopenfilename(filetypes=[("CSV files", "*.csv")])
        if not filepath:
            return
        with open(filepath, 'r', encoding='utf-8') as f:
            reader = csv.reader(f)
            header = next(reader)  # 跳过标题行
            count = 0
            for row in reader:
                if len(row) >= 2:
                    student_id, name = row[0], row[1]
                    age = row[2] if len(row) > 2 else None
                    gender = row[3] if len(row) > 3 else None
                    class_id = row[4] if len(row) > 4 else None
                    phone = row[5] if len(row) > 5 else None
                    address = row[6] if len(row) > 6 else None
                    enroll = row[7] if len(row) > 7 else None
                    try:
                        self.db.execute("INSERT OR IGNORE INTO students (student_id, name, age, gender, class_id, phone, address, enrollment_date) VALUES (?,?,?,?,?,?,?,?)",
                                       (student_id, name, age, gender, class_id, phone, address, enroll))
                        count += 1
                    except:
                        pass
        messagebox.showinfo("导入", f"成功导入 {count} 条学生记录")
        self.refresh_students()

    def export_students(self):
        filepath = filedialog.asksaveasfilename(defaultextension=".csv", filetypes=[("CSV files", "*.csv")])
        if not filepath:
            return
        rows = self.db.query("SELECT student_id, name, age, gender, class_id, phone, address, enrollment_date FROM students")
        with open(filepath, 'w', encoding='utf-8', newline='') as f:
            writer = csv.writer(f)
            writer.writerow(["学号", "姓名", "年龄", "性别", "班级编号", "电话", "地址", "入学日期"])
            writer.writerows(rows)
        messagebox.showinfo("导出", "导出成功")

